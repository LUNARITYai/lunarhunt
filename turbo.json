{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../panopticon.charter.yaml",
        "../wardens/schema/**"
      ]
    },
    "contract:check": {
      "cache": false,
      "dependsOn": ["^typecheck"]
    },
    "check": {
      "dependsOn": ["lint", "typecheck", "test", "contract:check"],
      "cache": false
    }
  }
}
