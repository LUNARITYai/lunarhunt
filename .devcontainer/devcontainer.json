{
  "name": "LunarHunt",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/lunarhunt",
  "remoteUser": "node",
  "postCreateCommand": "pnpm install --frozen-lockfile && uv sync --frozen --all-groups && pnpm exec lefthook install",
  "containerEnv": {
    "COMPOSE_PROJECT_NAME": "lunarhunt",
    "DATABASE_URL": "postgresql://lunarhunt:lunarhunt@postgres:5432/lunarhunt",
    "WEB_PORT": "3000",
    "API_PORT": "8000",
    "UV_PYTHON": "3.14.10"
  },
  "forwardPorts": [3000, 8000, 5432],
  "portsAttributes": {
    "3000": {
      "label": "web"
    },
    "8000": {
      "label": "api"
    },
    "5432": {
      "label": "postgres"
    }
  }
}
