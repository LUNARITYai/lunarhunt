# Local development placeholders. Not secrets.
# Worktree setup copies this file to .env and fills per-task values (ADR-0012).
# The Dev Container overrides DATABASE_URL so the host name is the compose service `postgres`.

COMPOSE_PROJECT_NAME=lunarhunt
DATABASE_URL=postgresql://lunarhunt:lunarhunt@localhost:5432/lunarhunt
WEB_PORT=3000
API_PORT=8000
TASK_ISSUE=
